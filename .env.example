# ==============================================================================
# SalesBrain Navigator - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Authentication Mode
# ------------------------------------------------------------------------------
# 'local' -> Mock auth for local development (no Firebase required).
# 'firebase' -> Strict JWT token verification (required for production).
AUTH_MODE=local
# RENDER=true will force IS_PRODUCTION=true, which fails closed if AUTH_MODE=local
RENDER=false

# ------------------------------------------------------------------------------
# Frontend: Firebase JS SDK Configuration (Public)
# ------------------------------------------------------------------------------
# These variables configure the client-side Firebase Auth SDK.
# Safe to commit to Vercel/Render frontend environments, but DO NOT PUT SECRETS HERE.
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------------------------
# Backend: Firebase Admin Configuration (Secret)
# ------------------------------------------------------------------------------
# Paste the contents of your Firebase Service Account JSON key.
# Alternatively, point GOOGLE_APPLICATION_CREDENTIALS to a local file.
# FIREBASE_SERVICE_ACCOUNT={"type": "service_account", "project_id": "..."}

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# SQLite (Local Default or Render Free Ephemeral Storage)
DATABASE_URL=sqlite:///./backend/app/data/salesbrain.db
ALLOW_EPHEMERAL_SQLITE=true
# PostgreSQL (Production Recommended)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# ------------------------------------------------------------------------------
# API & Network Configuration
# ------------------------------------------------------------------------------
# Frontend: Where to find the backend (defaults to localhost:8000/api/v1 locally)
# NEXT_PUBLIC_API_BASE_URL=https://your-backend.onrender.com/api/v1

# Backend: Allowed CORS origins
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.onrender.com
