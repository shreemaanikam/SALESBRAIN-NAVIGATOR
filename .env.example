# Authentication Mode
# Use 'local' for local development without Firebase. 
# Use 'firebase' for production JWT verification.
AUTH_MODE=local

# Database Configuration
# For local development:
DATABASE_URL=sqlite:///./backend/app/data/salesbrain.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@hostname:port/dbname

# Render Deployment Flag
# Automatically set to 'true' in Render. Enables strict mode in local auth.
RENDER=false
